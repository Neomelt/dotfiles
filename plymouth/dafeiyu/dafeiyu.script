frame[110] = Image("frame-110.png");

num_frames = 110;

anim = Sprite();
anim.SetPosition(
    Math.Int((screen_width  - 200) / 2),
    Math.Int((screen_height - 200) / 2),
    1
);

// Progress bar
bar_h = 2;
bar_y = screen_height - 40;
bar_bg_img = Image.New(screen_width, bar_h);
bar_bg_img.Fill(0.12, 0.16, 0.24, 1.0);
bar_bg = Sprite(bar_bg_img);
bar_bg.SetPosition(0, bar_y, 1);

bar_sprite = Sprite();
bar_sprite.SetPosition(0, bar_y, 2);

current_frame = 1;
progress = 0.0;

fun refresh_callback() {
    anim.SetImage(frame[current_frame]);
    current_frame++;
    if (current_frame > num_frames) current_frame = 1;

    w = Math.Int(screen_width * progress);
    if (w < 1) w = 1;
    bar_img = Image.New(w, bar_h);
    bar_img.Fill(0.36, 0.56, 0.96, 1.0);
    bar_sprite.SetImage(bar_img);
}

fun boot_progress_callback(duration, progress_val) {
    progress = progress_val;
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
